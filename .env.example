# Copie para `.env` (ou `.env.local`) e preencha. NÃO commite o arquivo real.

# ── Sharky ────────────────────────────────────────────────────────────────
# Meta/SEO + analytics são assados no BUILD; os itens revalidam sozinhos (60 s).
# Mudar a meta no backoffice só reflete após novo deploy — configure o Deploy
# Hook do projeto (Project.deployHookUrl) para redeployar ao salvar.
NEXT_PUBLIC_SHARKY_API_URL=https://api.bysharky.com
NEXT_PUBLIC_SHARKY_PROJECT_ID=
# CDN que serve as imagens da Sharky (o catálogo retorna caminhos relativos).
NEXT_PUBLIC_SHARKY_CDN_URL=https://sharky.b-cdn.net

# ── Site ──────────────────────────────────────────────────────────────────
# URL canônica pública — usada em metadataBase, sitemap.xml e robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Contato ───────────────────────────────────────────────────────────────
# WhatsApp (só dígitos, com DDI+DDD, ex.: 14705551234). Opcional: se vazio, o
# ícone e o botão de WhatsApp somem.
NEXT_PUBLIC_WHATSAPP=
# Telefone para ligação (só dígitos). Opcional: se vazio, usa o número do WhatsApp.
NEXT_PUBLIC_PHONE=
